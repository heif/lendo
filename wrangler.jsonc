{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lendo",
  "main": "src/index.tsx",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "lendo", "database_id": "2cdee7e8-c29d-49ad-94e9-92caf327bc34", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "lendo-photos" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_URL": "https://lendo.co",
    "FEE_PCT": "15",
    "MIN_PRICE_CENTS": "800",
    "BLOOIO_API_BASE": "https://api.blooio.com/v2/api",
    "LENDO_NUMBER": "(907) 535-3342",
    // Mapbox. MAPBOX_PUBLIC_TOKEN (pk., URL-restricted) is a Worker *secret* in prod (push protection rejects it in git) or a .dev.vars entry locally; unset = Leaflet/OSM fallback.
    "MAPBOX_STYLE_URL": "mapbox://styles/mapbox/light-v11",
    "MEETUP_SPOTS": "true",
    "WANTED_PROMO": "false",
    "ADMIN_PHONES": "+19176784343"
  }
  // Secrets (set with `wrangler secret put NAME`):
  //   SESSION_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  //   BLOOIO_API_KEY, BLOOIO_WEBHOOK_SECRET, MAPBOX_SECRET_TOKEN (sk., server-side geocoding only)
  // For local dev put them in .dev.vars (see .dev.vars.example).
}
