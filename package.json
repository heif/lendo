{
  "name": "lendo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && for f in public/*.js; do node --check $f || exit 1; done",
    "db:migrate:local": "wrangler d1 migrations apply lendo --local",
    "db:migrate": "wrangler d1 migrations apply lendo --remote",
    "cf-typegen": "wrangler types",
    "hoods:fetch": "node scripts/fetch-nta.mjs",
    "hoods:seed": "wrangler d1 execute lendo --remote --file data/hoods.sql",
    "hoods:seed:local": "wrangler d1 execute lendo --local --file data/hoods.sql"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "hono": "^4.6.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
